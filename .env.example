# ---- Service ----
ENVIRONMENT=production           # dev | staging | production
HOST=0.0.0.0                      # uvicorn bind (container-internal)
PORT=5002
LOG_LEVEL=INFO
SQL_ECHO=false                    # never true in production
SERVICE_NAME=nightsservice
VERSION=0.2.0

# Comma-separated list of allowed CORS origins; leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=https://nights.example.com

# Comma-separated list of trusted Host headers, or * to disable enforcement.
TRUSTED_HOSTS=nights-api.example.com

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE_NAME=nights
